# Cloudflare Workers Environment Variables for Volunteer Activity Hub
# Copy this file to .env.local for local development, or set as wrangler secrets for production

# Database (TiDB via Hyperdrive)
# HYPERDRIVE connection details are set via wrangler secret in production
# For local development, you can set these if testing locally
# HYPERDRIVE_HOST=
# HYPERDRIVE_USER=
# HYPERDRIVE_PASSWORD=
# HYPERDRIVE_DATABASE=
# HYPERDRIVE_PORT=

# Session Storage (KV)
# SESSIONS KV binding is configured in wrangler.toml
SESSION_LIFETIME=21600000

# Email Configuration (Gmail SMTP)
# IMPORTANT: Set these as wrangler secrets, NOT in .env file
# Commands:
#   npx wrangler secret put GMAIL_USER
#   npx wrangler secret put GMAIL_APP_PASSWORD
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# CORS Configuration
# IMPORTANT: Set as wrangler secret in production
# Format: comma-separated list of allowed origins
# Command: npx wrangler secret put ALLOWED_ORIGINS
# Example value: "https://yourdomain.com,https://www.yourdomain.com"
# ALLOWED_ORIGINS=

# Photo Verification Settings
MAX_DISTANCE_METERS=300
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png
MAX_UPLOADS_PER_REGISTRATION=3

# R2 Bucket Configuration
# PHOTOS_BUCKET binding is configured in wrangler.toml
# For production, set R2_PUBLIC_URL as wrangler secret if using signed URLs
# R2_PUBLIC_URL=your-api-key

# Security
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCK_MINUTES=360

# Activity Rules
OPEN_TIME=08:00
CLOSE_TIME=20:00
REMINDER_MINUTES=30
