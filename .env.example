# Cloudflare Workers Environment Variables

# Database Configuration (MySQL/TiDB)
# Use wrangler secret put DATABASE_URL
# Example: mysql://user:password@host:port/database?sslMode=REQUIRED
DATABASE_URL=mysql://user:password@your-tidb-host:4000/volunteer_db?sslMode=REQUIRED

# Database CA Certificate (required for SSL connection)
# Use wrangler secret put DB_CA_CERT
# Download from your database provider and paste the entire certificate content
DB_CA_CERT=-----BEGIN CERTIFICATE-----
...paste your CA certificate content here...
-----END CERTIFICATE-----

# Email Configuration (for sending notifications)
# Use wrangler secret put for sensitive values
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@volunteer.system

# Alternative: Use email API service (e.g., SendGrid, Mailgun, Resend, Cloudflare Email Routing)
# EMAIL_API_KEY=your-api-key
# EMAIL_API_URL=https://api.email-service.com/send

# Security
MAX_LOGIN_ATTEMPTS=10
LOGIN_LOCK_MINUTES=360

# Activity Rules
OPEN_TIME=08:00
CLOSE_TIME=20:00
REMINDER_MINUTES=30
